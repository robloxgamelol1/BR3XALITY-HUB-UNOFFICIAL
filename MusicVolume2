local conn = RunService.RenderStepped:Connect(function(dt)
    rainbowHue = (rainbowHue + 0.003 * Config.SkeletonRainbowSpeed) % 1
    Accumulator = Accumulator + dt
    local interval = 1 / Config.FPS
    if Accumulator < interval then return end
    Accumulator = Accumulator % interval

    if not Camera then Camera = Workspace.CurrentCamera end
    local character = LocalPlayer.Character
    local localRoot = character and character:FindFirstChild("HumanoidRootPart")

    local rc = Color3.fromHSV(rainbowHue, 1, 1)
    for player, entry in pairs(Drawings) do
        if not player.Parent then
            removeDrawing(player)
        else
            local ok, err = pcall(updatePlayer, player, entry, Camera, localRoot, rc)
            if not ok then
                warn("[BR3XALITY ESP] " .. tostring(err))
            end
        end
    end
end)

