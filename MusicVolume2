    local part = target:FindFirstChild(Config.AimbotPart)
    if not part then return end
    local predicted = getPredictedPosition(part, Config.AimbotPrediction)
    if not predicted then return end
    local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, predicted)
    local screenPos = project(Camera, predicted)
    if screenPos then
        local delta = (screenPos - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
        if delta < Config.AimbotDeadzone then return end
    end
    local jitter = Vector3.new(
        (math.random() - 0.5) * Config.AimbotJitter,
        (math.random() - 0.5) * Config.AimbotJitter,
        0
    )
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame * CFrame.new(jitter), Config.AimbotSmoothness)
end)

local musicSound = nil
local musicLoaded = false

local function playMusic()
    if musicLoaded and musicSound then musicSound:Play() return true end
    local asset = loadMusic()
    if not asset then return false end
    if not musicSound then
        musicSound = Instance.new("Sound")
        musicSound.Name = "BR3XALITY_Music"
        musicSound.Looped = Config.MusicLooped
        musicSound.Volume = Config.MusicVolume
        musicSound.Parent = SoundService
    end
    musicSound.SoundId = asset
    musicSound.Volume = Config.MusicVolume
    musicSound:Play()
    musicLoaded = true
    return true
end

local function stopMusic() if musicSound then musicSound:Stop() end end
local function setMusicVolume(v)
    v = math.clamp(v, 0, 10)
    Config.MusicVolume = v
    if musicSound then musicSound.Volume = v end
end
local function setMusicLoop(v)
    Config.MusicLooped = v
    if musicSound then musicSound.Looped = v end
end

